# SnapLedger — environment variables
#
# Copy this file to `.env` (git-ignored) and fill in the values:
#   cp .env.example .env
#
# This file is committed, so it must NEVER contain real secrets.
# Both docker compose and the API read the same `.env`, so names are shared.

# --- PostgreSQL (used by docker-compose.yml and the API) ---------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=snapledger
POSTGRES_USER=snapledger
# Any strong local password. Generate one with: openssl rand -base64 24 | tr -d '\n/+='
POSTGRES_PASSWORD=

# --- API security -------------------------------------------------------------
# HS256 signing key for access tokens. Base64, at least 256 bits (32 bytes).
# The API refuses to start without it. It must be ONE line. Generate with:
#   openssl rand -base64 64 | tr -d '\n'
# (openssl wraps Base64 output every 64 characters; tr -d '\n' removes the line breaks)
JWT_SECRET=

# Comma-separated list of browser origins allowed by CORS. Never use "*".
# Flutter Web in dev: run with `flutter run -d chrome --web-port 8081`.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- AI receipt scanning (Phase 3, backend only — see docs/decisions/0003) ----
# Leave empty until Phase 3. Never pass this to the Flutter app.
AI_API_KEY=

# --- Flutter app (NOT read from this file) -------------------------------------
# The app receives its API URL at build time via --dart-define, for example:
#   flutter run --dart-define=API_BASE_URL=http://localhost:8080
# Android emulator reaches the host machine at http://10.0.2.2:8080
