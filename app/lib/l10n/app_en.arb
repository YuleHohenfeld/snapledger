  "passwordResetTitle": "Forgot your password?",
  "@passwordResetTitle": {
    "description": "Headline of the first step of the password reset (email)."
  },
  "passwordResetEmailIntro": "We will email you a 6-digit code.",
  "@passwordResetEmailIntro": {
    "description": "One supporting line on the first step of the password reset."
  },
  "passwordResetSendCode": "Send code",
  "@passwordResetSendCode": {
    "description": "Button of the first step of the password reset."
  },
  "passwordResetNewPasswordTitle": "Create a new password",
  "@passwordResetNewPasswordTitle": {
    "description": "Headline of the third step of the password reset."
  },
  "passwordResetNewPasswordSubtitle": "Choose one you do not use anywhere else.",
  "@passwordResetNewPasswordSubtitle": {
    "description": "One supporting line on the third step of the password reset."
  },
  "passwordResetNewPasswordLabel": "New password",
  "@passwordResetNewPasswordLabel": {
    "description": "Label of the new password field of the password reset."
  },
  "passwordResetSubmit": "Change password",
  "@passwordResetSubmit": {
    "description": "Button of the second step of the password reset."
  },
  "passwordResetDoneTitle": "Password changed",
  "@passwordResetDoneTitle": {
    "description": "Headline shown when the password was changed."
  },
  "passwordResetDoneBody": "Every device was signed out.",
  "@passwordResetDoneBody": {
    "description": "Explanation shown when the password was changed: the server revoked every session."
  },
  "passwordResetBackToLogin": "Back to sign in",
  "@passwordResetBackToLogin": {
    "description": "Button that goes back to the login screen."
  },

  "codeVerificationTitle": "Check your email",
  "@codeVerificationTitle": {
    "description": "Headline of the code verification screen (password reset and verify email)."
  },
  "codeVerificationBody": "We sent a 6-digit code to {email}",
  "@codeVerificationBody": {
    "description": "Text under the headline of the code verification screen; the View makes the email bold.",
    "placeholders": {
      "email": {
        "type": "String",
        "example": "ana@example.com"
      }
    }
  },
  "codeSemanticsLabel": "Verification code, 6 digits",
  "@codeSemanticsLabel": {
    "description": "Screen reader label of the six-box code input."
  },
  "codeWrong": "That code is not right. Try again.",
  "@codeWrong": {
    "description": "Shown under the code boxes when the server refused the code (wrong, expired or already used)."
  },
  "codeVerified": "Code verified",
  "@codeVerified": {
    "description": "Screen reader announcement and label of the check shown under the boxes when the code was accepted."
  },
  "codeVerifying": "Checking the code",
  "@codeVerifying": {
    "description": "Screen reader label of the subtle progress bar shown while the code is being checked."
  },

  "passwordRequirementMinLength": "At least {min} characters",
  "@passwordRequirementMinLength": {
    "description": "Item of the live password checklist; turns green once the password has the minimum length (counted in UTF-8 bytes).",
    "placeholders": {
      "min": {
        "type": "int",
        "example": "8"
      }
    }
  },
  "requirementMet": "met",
  "@requirementMet": {
    "description": "Screen reader suffix of a checklist item that is satisfied."
  },
  "requirementNotMet": "not met yet",
  "@requirementNotMet": {
    "description": "Screen reader suffix of a checklist item that is not satisfied yet."
  },

  "errorResetSessionExpired": "Your reset session expired. Please start again.",
  "@errorResetSessionExpired": {
    "description": "The server answered invalid-reset-token on the new password step; the flow goes back to the email step."
  },

  "verifyEmailSkip": "Skip for now",
  "@verifyEmailSkip": {
    "description": "Text button that leaves the Verify email screen without verifying."
  },
  "verifyEmailSuccess": "Email verified. Thank you!",
  "@verifyEmailSuccess": {
    "description": "Shown when the email was verified."
  },
  "verifyEmailContinue": "Continue",
  "@verifyEmailContinue": {
    "description": "Button shown with the verified message; leaves the Verify email screen."
