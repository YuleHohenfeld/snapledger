  "errorInvalidCode": "That code is wrong or has expired. Check it or ask for a new one.",
  "@errorInvalidCode": {
    "description": "The server answered invalid-code. Deliberately does not say whether the code was wrong, expired or used."
  },
  "errorTooManyRequests": "Too many attempts. Please wait a while and try again.",
  "@errorTooManyRequests": {
    "description": "The server answered 429 too-many-requests."
  },

  "loginForgotPassword": "Forgot password?",
  "@loginForgotPassword": {
    "description": "Text button under the password field of the login screen; opens the password reset."
  },

  "codeResendPrompt": "Didn't get it?",
  "@codeResendPrompt": {
    "description": "Plain text before the resend button on the code verification screen."
  },
  "codeResend": "Resend code",
  "@codeResend": {
    "description": "Button that asks for a new code by email."
  },
  "codeResendIn": "Resend in {seconds}",
  "@codeResendIn": {
    "description": "The resend button while it is disabled by the cooldown; seconds is a clock such as 0:42.",
    "placeholders": {
      "seconds": {
        "type": "String",
        "example": "0:42"
      }
    }
  },
  "validationCodeInvalid": "Enter the 6 digits of the code.",
  "@validationCodeInvalid": {
    "description": "Shown under the code field when it does not have exactly 6 digits."
